rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Employees
    match /employees/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Enquiries and audits
    match /enquiries/{docId} {
      allow read, write: if request.auth != null;
      match /audits/{auditId} {
        allow read, write: if request.auth != null;
      }
    }

    // Bills and Transactions
    match /bills/{docId} {
      allow read, write: if request.auth != null;
    }

    match /billTransactions/{docId} {
      allow read, write: if request.auth != null;
    }

    // Products and Inventory Transactions
    match /products/{docId} {
      allow read, write: if request.auth != null;
    }

    match /transactions/{docId} {
      allow read, write: if request.auth != null;
    }

    // Tasks and Teams
    match /tasks/{docId} {
      allow read, write: if request.auth != null;
    }

    match /teams/{docId} {
      allow read, write: if request.auth != null;
    }

    // Training and Notifications
    match /training/{docId} {
      allow read, write: if request.auth != null;
    }

    match /notifications/{docId} {
      allow read, write: if request.auth != null;
    }

    match /employeeLogin/{docId} {
      allow read, write: if request.auth != null;
    }

    // Allow authenticated users read & write for all collections in internal ERP
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
